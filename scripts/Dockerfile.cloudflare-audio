# Cloudflare Containers runs the existing Python audio engine, not Vercel Functions.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY scripts/requirements.cloudflare-audio.txt ./requirements.txt
COPY scripts/audio_pipeline/requirements.txt ./audio_pipeline/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY scripts/audio_pipeline/ ./audio_pipeline/
EXPOSE 8080
CMD ["uvicorn", "audio_pipeline.cloudflare_service:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
