# Server-only Supabase Auth configuration. The publishable key is safe by
# design, but Cove still keeps Auth requests on the Worker so session cookies
# can remain HttpOnly.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
FORE_AUTH_MODE=supabase
FORE_PUBLIC_URL=https://your-cove-site.example

# Vercel persistence gateway. The public Vercel app proxies Cove API traffic to the
# dedicated D1/R2 persistence Worker. Use the same strong random FORE_BACKEND_TOKEN
# on Vercel and the Worker; never expose it through VITE_* variables.
FORE_BACKEND_URL=https://cove-persistence-backend.your-subdomain.workers.dev
FORE_BACKEND_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_BYTES
# Shared only by the persistence Worker's scheduler and Vercel's protected ingestion
# controller. The Worker sends this as Authorization: Bearer <token>.
FORE_INGESTION_TRIGGER_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_BYTES
# CRON_SECRET may be used instead if you later move scheduling back to Vercel Cron.
# COVE_AUDIO_PIPELINE_URL is a Vercel service binding injected into the app.
# Do not define it manually. The audio service talks directly to FORE_BACKEND_URL.

# Used only when the deployment platform does not provide CF-IPCountry (for example local dev).
# Production Cloudflare requests use CF-IPCountry as the storefront territory.
FORE_DEFAULT_TERRITORY=US
FORE_GOOGLE_ENABLED=false

# Machine workers authenticate with scoped service-principal credentials issued from the
# staff control plane. Put the one-time plaintext credential in the worker secret manager as
# FORE_SERVICE_TOKEN; the Cove API stores only its SHA-256 hash. Do not configure one shared
# operator/admin token on the web application.
# FORE_SERVICE_TOKEN=fore_svc_<prefix>.<secret>  # worker process only, not the Cove API
# GUTENDEX_BASE_URL=https://gutendex.com
# GUTENBERG_MIRROR_BASE_URL=https://gutenberg.pglaf.org

# Commercial catalog search. Leave FORE_SEARCH_BACKEND=auto (or unset) to use
# Meilisearch 1.36+ when configured and D1 FTS5 otherwise. Keys are server-only.
FORE_SEARCH_BACKEND=auto
# FORE_SEARCH_URL=https://your-search-host.example
# FORE_SEARCH_SEARCH_KEY=
# FORE_SEARCH_ADMIN_KEY=
FORE_SEARCH_INDEX=fore_books
# Optional: name of a Meilisearch embedder already configured on the index.
# FORE_SEARCH_EMBEDDER=

# Commercial recommendations. Cove includes an in-process hybrid ranker and can
# optionally delegate candidate retrieval and final scoring to a private model service.
# FORE_RECOMMENDER_URL=https://your-recommender.example
# FORE_RECOMMENDER_API_KEY=
# FORE_RECOMMENDER_MODEL=fore-hybrid
# FORE_RECOMMENDER_TIMEOUT_MS=700

# Stripe commercial checkout. The publishable key is intentionally available
# to the browser; the secret and webhook signing secret must stay server-only.
STRIPE_PUBLISHABLE_KEY=pk_live_51U2mLeI83hMSbuqG7AlyoMIwkMiRnXAOzhu1xUWHQmgIyHIQ5CQbulG18lclVtV5taR9LFAecdJ0OQYt57028FdQ00UwZsetPA
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SIGNING_SECRET
STRIPE_LIVEMODE=true
STRIPE_TAX_ENABLED=true
STRIPE_CAPTURE_METHOD=automatic_async
STRIPE_MINIMUM_CHARGE_MINOR=50
# STRIPE_API_VERSION= # optional; omit to use the account's default API version
# For local/test Stripe, override BOTH keys and set STRIPE_LIVEMODE=false.
# Cove rejects mixed live/test publishable + secret key modes.
# Human finance, catalog, community, publisher-support, fraud and storefront operations
# use individually provisioned staff accounts with RBAC + MFA/SSO binding. No shared
# commerce/storefront admin bearer token is accepted.


# Customer notifications. The app writes a durable notification outbox; these server-only
# provider bridges perform the final outbound delivery. Web Push uses a public VAPID key
# in the browser and private provider credentials only behind the bridge.
# FORE_EMAIL_API_URL=https://notifications.example/internal/email
# FORE_EMAIL_API_KEY=REPLACE_WITH_PROVIDER_BRIDGE_SECRET
# FORE_WEB_PUSH_API_URL=https://notifications.example/internal/web-push
# FORE_WEB_PUSH_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
# FORE_MOBILE_PUSH_API_URL=https://notifications.example/internal/mobile-push
# FORE_PUSH_API_KEY=REPLACE_WITH_PUSH_PROVIDER_BRIDGE_SECRET

# Traditional publisher acknowledgement callbacks. Server-only master used to derive
# a stable per-publisher HMAC verification secret; use at least 32 random bytes.
# FORE_PARTNER_WEBHOOK_MASTER_SECRET=REPLACE_WITH_32_PLUS_RANDOM_BYTES

# Publisher/payee tax provider webhook. Server-only HMAC secret; use at least 32 random bytes.
# The normalized adapter signs `${timestamp}.${raw_body}` with HMAC-SHA256 and sends
# x-fore-tax-timestamp + x-fore-tax-signature: v1=<hex>. Never expose this as VITE_*.
# FORE_TAX_WEBHOOK_SECRET=REPLACE_WITH_32_PLUS_RANDOM_BYTES


# Production observability. External bridges are optional; internal incidents remain durable
# even when a provider is unavailable. Alert/error endpoints must be HTTPS.
# FORE_ALERT_WEBHOOK_URL=https://oncall.example/internal/fore-alerts
# FORE_ALERT_WEBHOOK_TOKEN=REPLACE_WITH_ONCALL_BRIDGE_SECRET
# FORE_ERROR_REPORTING_URL=https://errors.example/internal/events
# FORE_ERROR_REPORTING_TOKEN=REPLACE_WITH_ERROR_BRIDGE_SECRET

# Federated public-domain catalogs. Canada/Australia defaults are built in; override only with trusted mirrors.
# FORE_GUTENBERG_CANADA_CATALOG_URL=https://www.gutenberg.ca/index.html
# FORE_GUTENBERG_AUSTRALIA_CATALOG_URL=https://www.gutenberg.net.au/plusfifty.html
# Project Gutenberg Europe is NOT a blanket EU rights source. Configure an HTTPS, country-scoped JSON manifest.
# FORE_GUTENBERG_EUROPE_FEED_URL=https://your-controlled-mirror.example/pge-rights-manifest.json
# Comma-separated HTTPS origins allowed for Europe manifest assets/evidence, in addition to rastko.net defaults.
# FORE_GUTENBERG_EUROPE_TRUSTED_ORIGINS=https://your-controlled-mirror.example

# Cove Publishing control plane. Normal staff operations use individually provisioned
# account identities + staff RBAC + MFA/SSO binding, never a shared admin bearer token.
# This bootstrap credential is break-glass/provisioning only and should be tightly held/rotated.
FORE_STAFF_BOOTSTRAP_TOKEN=REPLACE_WITH_A_STRONG_RANDOM_STAFF_BOOTSTRAP_TOKEN
# Publishing/catalog/audio/operations workers use a scoped service-principal credential
# (FORE_SERVICE_TOKEN in that worker's secret manager), separately rotated per workload.
# Leave false for mandatory human review. When true, automated-review "pass" submissions may
# proceed from automated review to approved/materialized without a human review.
FORE_PUBLISHING_AUTO_APPROVE_LOW_RISK=false
# Public designated copyright agent details. Configure these to match the agent/contact
# information Cove has formally registered/published for the operating entity and jurisdiction.
FORE_DMCA_AGENT_NAME=REPLACE_WITH_DESIGNATED_AGENT_NAME
FORE_DMCA_AGENT_EMAIL=copyright@example.com
FORE_DMCA_AGENT_ADDRESS=REPLACE_WITH_PUBLIC_AGENT_MAILING_ADDRESS
# FORE_DMCA_AGENT_PHONE=
# Identity, tax and payout vendors are intentionally adapter-driven. Cove stores only
# provider references/statuses and never raw ID documents, tax IDs/forms or bank credentials.
# Configure the chosen provider integration outside the core domain model, then update
# onboarding statuses through the authenticated publishing operations integration.

# Security program / deployment security. Set these in the deployment secret/config manager.
FORE_ENVIRONMENT=production
# Optional CSP reporting endpoint. Prefer a dedicated report collector; do not put credentials in this URL.
# FORE_CSP_REPORT_URI=https://security-reports.example.com/csp
FORE_SECURITY_CONTACT_EMAIL=security@example.com
FORE_SECURITY_POLICY_URL=https://example.com/security

# Production only: enqueue audio work onto Vercel Queue push subscribers.
# Leave unset in previews/local development to retain the direct execution fallback.
COVE_AUDIO_EXECUTION_MODE=queue
