{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "cove-fast-customer-gateway",
  "main": ".output/strangler/index.mjs",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "COVE_STOREFRONT_READ_LIMITER",
      "namespace_id": "732032",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ],
  "vars": {
    "COVE_STRANGLER_MODE": "customer-gateway",
    "COVE_STRANGLER_RELEASE_CERTIFIED": "0",
    "COVE_STRANGLER_EXPERIENCE": "1",
    "FORE_ENVIRONMENT": "production",
    "FORE_DEFAULT_TERRITORY": "US",
    "FORE_PUBLIC_URL": "https://cove-puce-theta.vercel.app"
  }
}
