{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cove-literary-publisher-isolated-disabled",
  "main": "literary-publisher-dist/worker.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 300000
  },
  "d1_databases": [],
  "r2_buckets": [],
  "vars": {
    "FORE_LITERARY_INFERENCE_PUBLISH_ENABLED": "0",
    "COVE_LITERARY_PRIVATE_READ_ENABLED": "1",
    "COVE_LITERARY_PRIVATE_PUBLICATION_ENABLED": "1"
  },
  "services": [
    {
      "binding": "LITERARY_PRIMARY_READER",
      "service": "cove-legal-authority-production"
    },
    {
      "binding": "LITERARY_CANONICAL_OWNER",
      "service": "cove-legal-authority-production"
    }
  ],
  "secrets": {
    "required": [
      "COVE_LITERARY_READ_SECRET",
      "COVE_LITERARY_PUBLICATION_SECRET"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
