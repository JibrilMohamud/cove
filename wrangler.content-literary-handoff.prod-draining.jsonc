{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cove-literary-handoff-draining-20261025",
  "main": "content-dist/worker.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 300000
  },
  "d1_databases": [],
  "r2_buckets": [],
  "vars": {
    "FORE_CONTENT_PROCESSOR_ROLE": "literary-handoff",
    "FORE_CONTENT_PROCESSOR_ENABLED": "1",
    "FORE_CONTENT_PREPARE_ENABLED": "1",
    "FORE_CONTENT_HANDOFF_ENABLED": "1",
    "FORE_LITERARY_DRAIN_RECONCILE_ENABLED": "1",
    "FORE_CONTENT_D1_ADMISSION_MAX_MS": "100",
    "COVE_LITERARY_PRIVATE_HANDOFF_ENABLED": "1"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "services": [
    {
      "binding": "LITERARY_CANONICAL_OWNER",
      "service": "cove-legal-authority-production"
    }
  ],
  "secrets": {
    "required": [
      "COVE_LITERARY_HANDOFF_SECRET"
    ]
  }
}
