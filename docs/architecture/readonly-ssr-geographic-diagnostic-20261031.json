  "relaySource": "export default {async fetch(request,env){\n const headers={'content-type':'application/json','cache-control':'no-store','x-robots-tag':'noindex, nofollow'};\n const reply=(value,status=200)=>new Response(JSON.stringify(value),{status,headers});\n if(request.method!=='GET'||new URL(request.url).pathname!=='/'||Date.now()>=Number(env.EXPIRES_AT)||request.cf?.country!=='US')return reply({available:false},404);\n try{\n  const forwarded=new Request('https://cove-storefront-ssr-staging.cove-jibrilmohamud.workers.dev/',request);\n  forwarded.headers.set('authorization','Bearer '+env.STAGING_GATE);\n  forwarded.headers.delete('cookie');\n  const start=performance.now(); const response=await env.SSR.fetch(forwarded);\n  const html=await response.text();\n  if(html.length>4000000)return reply({available:false},503);\n  const cards=(html.match(/class=[\"']book-card[\"']/g)||[]).length;\n  const phases={};for(const m of (response.headers.get('server-timing')||'').matchAll(/\\b(cove_[a-z_]+);dur=([0-9]+(?:\\.[0-9]+)?)/g))phases[m[1]]=Number(m[2]);\n  return reply({schema:'cove.readonly-ssr-geo-diagnostic.v1',relayColo:request.cf.colo,country:request.cf.country,upstreamStatus:response.status,cards,serviceElapsedMs:Math.round(performance.now()-start),serverTimingMs:phases,bodyComplete:true},response.status===200&&cards===24?200:503);\n }catch{return reply({schema:'cove.readonly-ssr-geo-diagnostic.v1',available:false},503);}\n}};",
