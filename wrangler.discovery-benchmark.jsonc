{
  "name": "cove-discovery-read-model-staging",
  "main": "artifacts/discovery-benchmark/worker.mjs",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "limits": { "cpu_ms": 30000 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cove-perf-isolated-candidate-20261019",
      "database_id": "e4cbb0ef-6288-4fa1-9dbb-fb42fe01d4f3",
    },
    {
      "binding": "ENGAGEMENT_DB",
      "database_name": "cove-engagement-isolated-20261020",
      "database_id": "86915082-bfa5-478e-a8c4-90d05f01e62c",
      "migrations_dir": "engagement-migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "DISCOVERY_MODELS", "bucket_name": "cove-discovery-models-benchmark" },
  ],
  "ratelimits": [
    {
      "name": "COVE_STOREFRONT_READ_LIMITER",
      "namespace_id": "732041",
      "simple": { "limit": 180, "period": 60 },
    },
  ],
  "vars": {
    "FORE_ENVIRONMENT": "production",
    "FORE_DEFAULT_TERRITORY": "US",
    "COVE_SSR_STAGING": "1",
    "COVE_PERF_DATABASE_ID": "e4cbb0ef-6288-4fa1-9dbb-fb42fe01d4f3",
    "COVE_PERF_ENGAGEMENT_DATABASE_ID": "86915082-bfa5-478e-a8c4-90d05f01e62c",
    "COVE_PERF_TELEMETRY_MODE": "durable",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
