{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "cove-sounds-publication",
  "main": ".output/strangler/sounds-publication.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "SOURCE_DB",
    "database_name": "cove-production",
    "database_id": "4bd657ac-8789-403e-a28c-93aba8d0a989"
  }],
  "r2_buckets": [{
    "binding": "SOUNDS_PRESENTATION",
    "bucket_name": "cove-sounds-private-presentation"
  }],
  "kv_namespaces": [{ "binding": "SOUNDS_PRESENTATION_KV", "id": "544267f3cf604c1d8976f1b06d258e24" }],
  "vars": {
    "COVE_SOUNDS_PUBLICATION_ENABLED": "0",
    "COVE_SOUNDS_MARKETS": "US"
  },
  "triggers": { "crons": ["11 * * * *"] }
}
