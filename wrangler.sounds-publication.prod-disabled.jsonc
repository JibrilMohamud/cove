{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "cove-sounds-publication",
  "main": ".output/strangler/sounds-publication.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "r2_buckets": [
    {
      "binding": "SOUNDS_PRESENTATION",
      "bucket_name": "cove-sounds-private-presentation",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SOUNDS_PRESENTATION_KV",
      "id": "544267f3cf604c1d8976f1b06d258e24",
    },
  ],
  "vars": {
    "COVE_SOUNDS_PUBLICATION_ENABLED": "0",
    "COVE_SOUNDS_MARKETS": "US",
  },
  "triggers": {
    "crons": ["11 * * * *"],
  },
  "services": [
    {
      "binding": "SOUNDS_SOURCE_READER",
      "service": "cove-legal-authority-production",
    },
  ],
}
