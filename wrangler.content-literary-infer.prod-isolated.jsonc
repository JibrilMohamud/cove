{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "content-dist/worker.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 300000
  },
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "cove-literary-content-isolated-20261024",
      "database_id": "400c3af3-5d40-41fd-83cc-98228e40ddac"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cove-literary-originals-isolated-20261024"
    }
  ],
  "name": "cove-literary-infer-isolated-disabled",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "FORE_CONTENT_PROCESSOR_ROLE": "literary-infer",
    "FORE_CONTENT_PROCESSOR_ENABLED": "1",
    "FORE_CONTENT_PREPARE_ENABLED": "1",
    "FORE_CONTENT_INFERENCE_ENABLED": "1",
    "FORE_CONTENT_BUDGET_MODE": "isolated",
    "FORE_CONTENT_D1_ADMISSION_MAX_MS": "100",
    "FORE_LITERARY_AUTOPUBLISH_ENABLED": "1",
    "COVE_LITERARY_PRIVATE_READ_ENABLED": "1"
  },
  "services": [
    {
      "binding": "LITERARY_PUBLISHER",
      "service": "cove-literary-publisher-isolated-disabled"
    },
    {
      "binding": "LITERARY_PRIMARY_READER",
      "service": "cove-legal-authority-production"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "secrets": {
    "required": [
      "FORE_LITERARY_INFERENCE_PUBLISH_TOKEN",
      "FORE_LITERARY_INFERENCE_BACKEND_TOKEN",
      "COVE_LITERARY_READ_SECRET"
    ]
  }
}
