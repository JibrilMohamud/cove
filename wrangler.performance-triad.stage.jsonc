    "COVE_TRIAD_EXPIRES_AT": "1970-01-01T00:00:00Z"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.1, "persist": true }
  }
}
