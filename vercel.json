{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "services": {
    "app": {
      "root": ".",
      "framework": "tanstack-start",
      "bindings": [
        {
          "type": "service",
          "service": "audio_pipeline",
          "format": "url",
          "env": "COVE_AUDIO_PIPELINE_URL"
        }
      ],
      "ignoreCommand": "node scripts/vercel-ignore-build.mjs app"
    },
    "audio_pipeline": {
      "root": "scripts",
      "framework": "fastapi",
      "functions": {
        "audio_pipeline/service.py": {
          "maxDuration": 300
        },
        "audio_pipeline/subscriber.py": {
          "maxDuration": 300
        }
      },
      "ignoreCommand": "node vercel-ignore-build.mjs audio"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
