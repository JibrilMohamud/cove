{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "tanstack-start",
      "bindings": [
        {
          "type": "service",
          "service": "audio_pipeline",
          "format": "url",
          "env": "COVE_AUDIO_PIPELINE_URL"
        }
      ]
    },
    "audio_pipeline": {
      "root": "scripts",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
