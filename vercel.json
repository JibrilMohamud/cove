{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "tanstack-start"
    },
    "audio_pipeline": {
      "root": "scripts",
      "framework": "fastapi",
      "entrypoint": "audio_pipeline.service:app",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "COVE_APP_INTERNAL_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
