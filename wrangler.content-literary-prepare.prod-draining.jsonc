{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cove-literary-prepare-draining-20261025",
  "main": "content-dist/worker.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 300000
  },
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "cove-literary-content-isolated-20261024",
      "database_id": "400c3af3-5d40-41fd-83cc-98228e40ddac"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cove-literary-originals-isolated-20261024"
    },
    {
      "binding": "SOURCE_BUCKET",
      "bucket_name": "cove-production-media"
    }
  ],
  "vars": {
    "FORE_CONTENT_PROCESSOR_ROLE": "literary-prepare",
    "FORE_CONTENT_PROCESSOR_ENABLED": "1",
    "FORE_CONTENT_PREPARE_ENABLED": "1",
    "FORE_CONTENT_D1_ADMISSION_MAX_MS": "100",
    "COVE_LITERARY_PRIVATE_READ_ENABLED": "1"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "services": [
    {
      "binding": "LITERARY_PRIMARY_READER",
      "service": "cove-legal-authority-production"
    }
  ],
  "secrets": {
    "required": [
      "COVE_LITERARY_READ_SECRET"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
