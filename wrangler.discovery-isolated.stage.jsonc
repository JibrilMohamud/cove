{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cove-discovery-isolated-stage",
  "main": ".output/strangler/isolated-producer.mjs",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DISCOVERY_DB",
      "database_name": "cove-perf-isolated-control-20261019",
      "database_id": "cc842ee5-c526-431e-96ee-5e093fb45e6d",
    },
  ],
  "r2_buckets": [
    { "binding": "PRESENTATION", "bucket_name": "cove-strangler-private-presentation-stage" },
  ],
  "vars": {
    "COVE_DISCOVERY_PRODUCER_ENABLED": "0",
    "COVE_DISCOVERY_DATABASE_ID": "cc842ee5-c526-431e-96ee-5e093fb45e6d",
  },
}
