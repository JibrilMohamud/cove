{
  "name": "cove-publication-export-stage",
  "main": ".output/strangler/publication-export.mjs",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "SOURCE_DB",
      "database_name": "cove-publication-source-stage-20261022",
      "database_id": "1825b4a1-0329-408d-9cc2-a40e6a17c822",
    },
    {
      "binding": "DISCOVERY_DB",
      "database_name": "cove-discovery-publication-stage-20261022",
      "database_id": "b299be94-f885-47a5-9d0b-3a3ac494065a",
      "migrations_dir": "infra/discovery",
    },
  ],
  "vars": { "COVE_PUBLICATION_ENABLED": "0", "COVE_PRESENTATION_PREFIX": "feed/stage/" },
}
